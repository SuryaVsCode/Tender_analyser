    {
      "parameters": {
        "promptType": "define",
        "text": "=You extract structured data from an Indian government tender document.\n\nRules:\n- Return only data that is stated in the document. If something is not stated, use null. Never guess.\n- Dates must be ISO format in IST.\n- For every eligibility clause, copy the exact sentence into source_quote and give the clause number in clause_ref.\n- type must be one of: turnover, experience, certification, registration, financial, other.\n- Put amounts in rupees as plain numbers (convert lakh and crore).\n- List MSME or Startup relaxations under exemptions.\n\nDOCUMENT:\n{{ $json.tender_text }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1072,
        -16
      ],
      "id": "c66f11bf-f594-43e3-8f46-31d7c5b82712",
      "name": "Extract Fields"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json.output;\nconst t = $('Extract Fields').first().json.output;\n\nconst icon = { 'BID': '✅', 'NO-BID': '❌', 'REVIEW': '⚠️' }[r.verdict] || '❔';\nconst mark = { met: '✔', not_met: '✘', unknown: '?' };\n\nconst clauses = (r.clause_results || [])\n  .map(c => `${mark[c.status] || '?'} ${c.clause_ref || ''} ${c.reason}`)\n  .join('\\n');\nconst missing = (r.missing_documents || []).map(d => `• ${d}`).join('\\n') || 'None';\n\nlet msg = `${icon} ${r.verdict} (${r.score}/100)\\n${t.title || 'Tender'}\\n` +\n  `Deadline: ${t.submission_deadline || 'not found'}\\n\\n` +\n  `${r.summary}\\n\\nClauses:\\n${clauses}\\n\\nMissing documents:\\n${missing}`;\n\nif (msg.length > 3900) msg = msg.slice(0, 3900) + '…';\nreturn [{ json: { message: msg } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
