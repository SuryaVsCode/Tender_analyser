    {
      "parameters": {
        "jsCode": "const scraped = $('Code').all().map(i => i.json);\nconst existing = $input.all().map(i => i.json).filter(r => r.tender_key);\nconst byKey = new Map(existing.map(r => [r.tender_key, r]));\n\nreturn scraped.map(s => {\n  const old = byKey.get(s.tender_key);\n  let status = 'new';\n  if (old) {\n  const a = new Date(old.closing_ist).getTime();\n  const b = new Date(s.closing_ist).getTime();\n  status = (isNaN(a) || a !== b) ? 'changed' : 'unchanged';\n}\n  return { json: {\n    ...s,\n    status,\n    old_closing: old ? old.closing_ist : null,\n    row_id: old ? old.id : null\n  }};\n});"
      },
