    {
      "parameters": {
        "jsCode": "const corr = $('Code in JavaScript1').all().map(i => i.json);\nconst stored = $input.all().map(i => i.json).filter(r => r.tender_key);\n\nconst byRef = new Map();\nfor (const r of stored) {\n  const k = (r.ref || '').trim().toLowerCase();\n  if (!byRef.has(k)) byRef.set(k, []);\n  byRef.get(k).push(r);\n}\n\nreturn corr.map(c => {\n  const matches = byRef.get((c.ref || '').trim().toLowerCase()) || [];\n  let status = 'not_tracked';\n  let row = null;\n  if (matches.length > 1) status = 'ambiguous';\n  else if (matches.length === 1) {\n    row = matches[0];\n    const a = new Date(row.closing_ist).getTime();\n    const b = new Date(c.closing_ist).getTime();\n    status = (a !== b) ? 'date_extension' : 'no_date_change';\n  }\n  return { json: {\n    corrigendum_title: c.title,\n    ref: c.ref,\n    new_closing: c.closing_ist,\n    new_opening: c.opening_ist,\n    old_closing: row ? row.closing_ist : null,\n    tender_title: row ? row.title : null,\n    row_id: row ? row.id : null,\n    status\n  }};\n});"
      },
