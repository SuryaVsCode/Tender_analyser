    {
      "parameters": {
        "jsCode": "const base = 'https://eprocure.gov.in';\nconst strip = s => (s || '').replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').replace(/\\s+/g, ' ').trim();\nconst parse = s => {\n  const d = DateTime.fromFormat((s || '').trim(), 'dd-LLL-yyyy hh:mm a',\n    { zone: 'Asia/Kolkata', locale: 'en' });\n  return d.isValid ? d.toISO() : null;\n};\n\n// Collect every row HTML string, whether rows is a string or an array\nconst rowHtmls = [];\nfor (const item of $input.all()) {\n  const r = item.json.rows;\n  if (Array.isArray(r)) r.forEach(x => rowHtmls.push(String(x)));\n  else if (r) rowHtmls.push(String(r));\n}\n\nconst out = [];\nfor (const html of rowHtmls) {\n  const cells = [];\n  const re = /<td[^>]*>([\\s\\S]*?)<\\/td>/g;\n  let m;\n  while ((m = re.exec(html)) !== null) cells.push(m[1]);\n  if (cells.length < 4) continue; // skip header or empty rows\n\n  const hrefMatch = cells[0].match(/href=\"([^\"]+)\"/);\n  const title = strip(cells[0]).replace(/^\\d+\\.\\s*/, '');\n  const ref = strip(cells[1]);\n  const closing = parse(strip(cells[2]));\n  const opening = parse(strip(cells[3]));\n\n  const problems = [];\n  if (!ref) problems.push('missing_ref');\n  if (!closing) problems.push('bad_closing_date');\n  if (!opening) problems.push('bad_opening_date');\n  if (closing && opening && opening < closing) problems.push('opening_before_closing');\n\n  out.push({ json: {\n    tender_key: `${ref}|${title.toLowerCase().slice(0, 60)}`,\n    ref, title,\n    closing_ist: closing,\n    opening_ist: opening,\n    link: hrefMatch ? base + hrefMatch[1].replace(/&amp;/g, '&') : null,\n    confidence: problems.length ? 'needs_review' : 'high',\n    problems,\n    scraped_at: $now.toISO()\n  }});\n}\nreturn out;"
      },
